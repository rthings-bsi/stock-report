# ==============================================================================
# SPINDO WAREHOUSE - ENVIRONMENT VARIABLES
# Salin ke .env.local untuk development. Jangan commit nilai asli.
# ==============================================================================

# Development lokal: pakai SQLite, jangan sentuh Supabase produksi.
DISABLE_SUPABASE=true

# WAJIB di production. Minimal 32 karakter acak.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Password awal untuk seeding / migrasi akun default.
# Minimal 8 karakter; gunakan password acak yang kuat.
ADMIN_INITIAL_PASSWORD=replace-with-strong-admin-password
STAFF_INITIAL_PASSWORD=replace-with-strong-staff-password

# Supabase (hanya untuk deploy cloud).
# Aplikasi hanya memakai service role key dari server. Jangan pernah
# memakai anon/publishable key untuk operasi tulis.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
